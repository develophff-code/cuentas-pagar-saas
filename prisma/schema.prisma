generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  BASIC
  PROFESSIONAL
  ULTRA
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum InvoiceStatus {
  PENDIENTE
  EN_GRILLA
  APROBADA
  PAGADA
  POSTERGADA
  CANCELADA
}

model Plan {
  id                  String      @id @default(uuid())
  code                PlanCode    @unique
  name                String
  description         String?
  maxUsers            Int         @default(1)
  maxSuppliers        Int         @default(25)
  maxInvoices         Int         @default(100)
  hasSupplierReceipts Boolean     @default(false)
  hasAiInsights       Boolean     @default(false)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  prices              PlanPrice[]
  tenants             Tenant[]

  @@map("plans")
}

model PlanPrice {
  id        String    @id @default(uuid())
  planId    String
  amount    Decimal   @db.Decimal(12, 2)
  currency  String    @default("ARS")
  validFrom DateTime  @default(now())
  validTo   DateTime? // NULL indica que es el precio vigente actual
  createdAt DateTime  @default(now())

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([planId, validFrom, validTo])
  @@map("plan_prices")
}

model Tenant {
  id                 String             @id @default(uuid())
  cuit               String             @unique
  businessName       String
  address            String?
  planId             String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime           @default(now()) // 7 días a partir de la fecha de alta
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan              Plan?              @relation(fields: [planId], references: [id])
  users             TenantUser[]
  categories        Category[]
  suppliers         Supplier[]
  invoices          Invoice[]
  subscriptions     Subscription[]
  paymentGridConfig PaymentGridConfig?

  @@map("tenants")
}

model Subscription {
  id                String    @id @default(uuid())
  tenantId          String
  planPriceId       String?
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("ARS")
  status            String    @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  paymentProvider   String    @default("MERCADO_PAGO")
  externalReference String?   // ID de pago de Mercado Pago
  paymentLink       String?   // URL del link de pago enviado a WhatsApp
  paidAt            DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planPrice PlanPrice? @relation(fields: [planPriceId], references: [id])

  @@index([tenantId, status])
  @@map("subscriptions")
}

model TenantUser {
  id          String   @id @default(uuid())
  tenantId    String
  phoneNumber String   @unique // Formato internacional ej: 54911xxxxxxxx
  fullName    String
  role        UserRole @default(ADMIN)
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@map("tenant_users")
}

model Category {
  id        String   @id @default(uuid())
  tenantId  String?  // NULL indica categoría maestra/global disponible para todos los tenants
  name      String   // Nombre del rubro ej: "Ferretería", "Insumos", "Materia Prima"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suppliers Supplier[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Supplier {
  id           String   @id @default(uuid())
  tenantId     String
  categoryId   String
  businessName String   // Obligatorio
  phone        String   // Obligatorio: celular / WhatsApp directo
  cuit         String?  // Opcional para contemplar proveedores informales
  email        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bankAccounts SupplierBankAccount[]
  invoices     Invoice[]

  @@index([tenantId, cuit])
  @@index([tenantId, categoryId])
  @@map("suppliers")
}

model SupplierBankAccount {
  id          String   @id @default(uuid())
  supplierId  String
  bankName    String?
  cbuCvu      String?  // 22 dígitos
  alias       String?  // Alias alfanumérico
  accountType String?  // CC / CA
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_bank_accounts")
}

model Invoice {
  id                   String        @id @default(uuid())
  tenantId             String
  supplierId           String
  invoiceNumber        String
  invoiceType          String        @default("A") // Factura A, B, C, Recibo, etc.
  amount               Decimal       @db.Decimal(12, 2)
  vatAmount            Decimal?      @db.Decimal(12, 2)
  issueDate            DateTime?
  dueDate              DateTime
  scheduledPaymentDate DateTime      // Fecha asignada en la grilla semanal
  status               InvoiceStatus @default(EN_GRILLA)
  fileUrl              String?
  mimeType             String?
  notes                String?
  rawOcrData           Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledPaymentDate])
  @@index([tenantId, status])
  @@map("invoices")
}

model PaymentGridConfig {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  paymentDays      String   @default("MARTES,JUEVES") // Días de la semana permitidos para pagos
  morningAlertTime String   @default("08:00")         // Hora para el reporte diario
  autoSchedule     Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_grid_configs")
}

model ConversationSession {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  state       String   @default("IDLE")
  contextData Json?
  updatedAt   DateTime @updatedAt

  @@map("conversation_sessions")
}
